# The lighthouse's Caddyfile: two names, two jobs, one file.
#
# Deployed by vps/publish-constitution.sh, which installs this file whole. Anything
# not in here is gone from the box the next time that script runs — which is why
# the MCP seam lives here too rather than only in a hand-edit on the box.
#
# 1. lighthouse.river.io — the familiar's MCP seam, behind an ordinary certificate.
#    Ian chose this (2026-08-18) over handing a partner an SPKI pin: the mesh port
#    keeps its self-signed certificate because iOS devices pin its SPKI, so real TLS
#    is terminated out here and only the MCP path is proxied inward. Nothing else on
#    47100 is reachable through this host — none of the /mesh/* routes, none of the
#    /local/* ones.
lighthouse.river.io {
	encode zstd gzip

	handle /mcp {
		reverse_proxy https://127.0.0.1:47100 {
			transport http {
				tls
				# The upstream is the familiar's own mesh listener: self-signed, CN
				# "familiar-mesh", pinned by SPKI on iOS rather than named by hostname.
				# Verification is skipped for that reason alone, and the hop is loopback,
				# so it never leaves the machine.
				tls_insecure_skip_verify
			}
		}
	}

	# Everything else says nothing useful. This host exists to serve one path.
	handle {
		respond "familiar lighthouse" 404
	}
}

# 2. {$CONSTITUTION_DOMAIN} — the public reading room. Static bytes only.
#
# {$CONSTITUTION_DOMAIN} is substituted from the environment at deploy time; Caddy
# obtains and renews the certificate.
#
# What this serves: the constitution, in its four renderings, and nothing else.
# The web root contains only files copied by an explicit allowlist — there is no
# path from this server into /var/lib/familiar, the mesh data, or the group secret.

{$CONSTITUTION_DOMAIN} {
	root * /var/www/constitution
	encode gzip zstd

	header {
		# A public document. Say so, and let anything read it.
		Access-Control-Allow-Origin "*"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Strict-Transport-Security "max-age=31536000"
		# The constitution changes when the constitution changes. Until then, cache.
		Cache-Control "public, max-age=3600"
		-Server
	}

	# The machine-readable form, at the address the discovery work named.
	handle /.well-known/laws.json {
		header Content-Type "application/json; charset=utf-8"
		rewrite * /laws.v1.json
		file_server
	}

	# Short aliases, so the URLs in the article and the adoption kit are typeable.
	handle /laws.json {
		header Content-Type "application/json; charset=utf-8"
		rewrite * /laws.v1.json
		file_server
	}
	handle /laws.md {
		header Content-Type "text/markdown; charset=utf-8"
		rewrite * /laws.v1.md
		file_server
	}
	handle /adopt {
		header Content-Type "text/markdown; charset=utf-8"
		rewrite * /ADOPT.md
		file_server
	}
	handle /license {
		header Content-Type "text/plain; charset=utf-8"
		rewrite * /LICENSE
		file_server
	}

	handle /implementation {
		rewrite * /implementation.html
		file_server
	}

	# The Service Charter, downstream of the constitution, with the questions it
	# leads with and the room it keeps for disagreement.
	handle /charter {
		header Content-Type "text/markdown; charset=utf-8"
		rewrite * /charter.v1.md
		file_server
	}
	handle /charter.json {
		header Content-Type "application/json; charset=utf-8"
		rewrite * /charter.v1.json
		file_server
	}
	handle /red-team {
		header Content-Type "text/markdown; charset=utf-8"
		rewrite * /RED-TEAM.md
		file_server
	}
	handle /dissent {
		header Content-Type "text/markdown; charset=utf-8"
		rewrite * /DISSENT.md
		file_server
	}

	# The rendered page is the root.
	handle / {
		rewrite * /constitution.html
		file_server
	}

	# Everything else: the allowlisted files by their own names, no directory
	# listing, and a plain 404 for anything not copied here.
	handle {
		file_server {
			index constitution.html
		}
	}

	handle_errors {
		header Content-Type "text/plain; charset=utf-8"
		respond "{err.status_code} — this host publishes The Constitution of Co-existence and nothing else. Try / or /.well-known/laws.json" {err.status_code}
	}

	log {
		output file /var/log/caddy/constitution.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

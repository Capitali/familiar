<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>method</key>
	<string>app-store</string>
	<key>teamID</key>
	<string>8GHXL328AR</string>
	<!-- Manual signing, mirroring the iOS pipeline: cloud/automatic signing hits a permission error
	     with this ASC key, so we pin the certs + the Mac App Store profile created for
	     io.river.familiar.mac (via the ASC API). The app is signed with Apple Distribution; the
	     .pkg installer with the 3rd Party Mac Developer Installer cert.
	     The profile must embed a Distribution cert whose PRIVATE KEY is in the building Mac's
	     keychain, so the name here follows the ship machine: "Familiar AppStore
	     io.river.familiar.mac" is wildhorse's (cert 6317…8553, expires 2027-07-16, installed
	     2026-08-31 via the ASC API); "Familiar MacAppStore MacOnStick" (cert 27FF5K2QAM) is
	     MacOnStick's and still exists in ASC for when that machine returns. -->
	<key>signingStyle</key>
	<string>manual</string>
	<key>signingCertificate</key>
	<string>Apple Distribution</string>
	<key>installerSigningCertificate</key>
	<string>3rd Party Mac Developer Installer</string>
	<key>provisioningProfiles</key>
	<dict>
		<key>io.river.familiar.mac</key>
		<string>Familiar AppStore io.river.familiar.mac</string>
	</dict>
	<key>uploadSymbols</key>
	<true/>
	<key>destination</key>
	<string>export</string>
</dict>
</plist>

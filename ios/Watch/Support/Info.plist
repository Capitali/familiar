<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Familiar</string>
	<key>CFBundleDisplayName</key>
	<string>Familiar</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleIconName</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>WKApplication</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>WKCompanionAppBundleIdentifier</key>
	<string>io.river.familiar.ios</string>
	<key>WKRunsIndependentlyOfCompanionApp</key>
	<true/>
	<key>NSHealthShareUsageDescription</key>
	<string>The familiar notes your heart-rate trend (elevated / normal) — never raw readings.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>The familiar only reads your heart-rate trend; it never writes to Health.</string>
	<key>NSMotionUsageDescription</key>
	<string>The familiar notes coarse activity (walking, still) — never raw motion data.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>The watch shares a coarse position (rounded to ~100m) so the familiar knows where you are on the mesh — never a precise fix.</string>
	<!-- Mesh transport is TLS to self-signed peers, pinned/covenant-signed at the app layer — see
	     the iPhone app's Info.plist. Default ATS blocks the self-signed cert on non-local IPs, so
	     the watch could reach the familiar over the LAN but never off it. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
</dict>
</plist>
